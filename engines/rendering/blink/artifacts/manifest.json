{
    "engine": "nexus_blink",
    "engine_name": "Blink",
    "version": "0.1.0",

    "artifact_type": "rendering_engine",

    "source": {
        "directory": "../src",
        "include_directory": "../include"
    },

    "build": {
        "system": "CMake",
        "language": "C++",
        "standard": "C++20"
    },

    "artifacts": {
        "linux": {
            "x86_64": {
                "filename": "nexus_blink.so",
                "format": "ELF shared library",
                "status": "generated"
            },
            "aarch64": {
                "filename": "nexus_blink.so",
                "format": "ELF shared library",
                "status": "generated"
            }
        },

        "windows": {
            "x86_64": {
                "filename": "nexus_blink.dll",
                "format": "PE dynamic library",
                "status": "generated"
            },
            "arm64": {
                "filename": "nexus_blink.dll",
                "format": "PE dynamic library",
                "status": "generated"
            }
        },

        "macos": {
            "x86_64": {
                "filename": "nexus_blink.dylib",
                "format": "Mach-O dynamic library",
                "status": "generated"
            },
            "arm64": {
                "filename": "nexus_blink.dylib",
                "format": "Mach-O dynamic library",
                "status": "generated"
            }
        },

        "wasm": {
            "filename": "nexus_blink.wasm",
            "format": "WebAssembly",
            "status": "generated"
        }
    },

    "security": {
        "sandbox_required": true,
        "microvm_compatible": true,
        "integrity_verification_required": true,
        "signature_verification_required": true,
        "trust_verification_required": true
    },

    "runtime": {
        "hot_reload_supported": true,
        "rollback_supported": true,
        "health_monitoring_supported": true
    },

    "status": "development"
}
