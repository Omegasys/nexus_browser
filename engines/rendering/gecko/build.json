{
    "project": "nexus_gecko",
    "engine": "gecko",
    "version": "0.1.0",

    "language": "C++",
    "standard": "C++20",

    "build_system": "CMake",
    "minimum_cmake_version": "3.20",

    "targets": [
        "Linux",
        "Windows",
        "macOS"
    ],

    "architectures": [
        "x86_64",
        "aarch64",
        "arm64"
    ],

    "output": {
        "type": "shared_library",
        "name": "nexus_gecko"
    },

    "source": {
        "directory": "src",
        "include_directory": "include"
    },

    "security": {
        "sandbox_required": true,
        "microvm_compatible": true,
        "network_access_default": false,
        "filesystem_access_default": false,
        "javascript_sandbox_required": true,
        "capability_validation_required": true
    },

    "integration": {
        "rust_adapter": true,
        "rust_ffi": true,
        "nexus_bridge": true,
        "capability_system": true,
        "hot_reload": true,
        "rollback": true,
        "health_monitoring": true
    },

    "development": {
        "incremental_compilation": true,
        "parallel_compilation": true,
        "source_watching": true,
        "automatic_validation": true,
        "automatic_testing": true,
        "automatic_hot_reload": true
    },

    "artifacts": {
        "directory": "artifacts",
        "linux": "nexus_gecko.so",
        "windows": "nexus_gecko.dll",
        "macos": "nexus_gecko.dylib",
        "wasm": "nexus_gecko.wasm"
    }
}
