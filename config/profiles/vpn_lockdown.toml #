# Nexus Browser
# VPN Lockdown Profile
#
# Browser traffic must remain inside the configured VPN route.
# Direct network fallback is prohibited.

[profile]
id = "vpn_lockdown"
name = "VPN Lockdown"
description = "Requires VPN routing and blocks traffic if the VPN becomes unavailable."
privacy_level = "high"
security_level = "maximum"
network_mode = "vpn"

[general]
hardware_acceleration = true
smooth_scrolling = true
autoplay_media = false
spell_check = true

[privacy]
fingerprinting_protection = "strict"
tracker_protection = "maximum"

block_third_party_cookies = true
partition_storage = true

resist_link_tracking = true
disable_prefetching = true
disable_speculative_connections = true

[webrtc]
enabled = true
allow_local_addresses = false
allow_public_addresses = false
proxy_only = true
block_non_proxy_connections = true

[storage]
partition_cookies = true
partition_cache = true
partition_indexeddb = true
partition_local_storage = true
partition_session_storage = true
partition_cache_storage = true
partition_service_workers = true
partition_shared_workers = true

[security]
sandbox = "maximum"
site_isolation = true
process_isolation = true
microvm_isolation = true

escape_detection = true

network_lock = true
kill_switch = true

secure_dns_required = true
block_mixed_content = true
block_dangerous_downloads = true

extension_sandbox = true
strict_permissions = true

[permissions]
deny_unknown_permissions = true
deny_cross_origin_permissions = true

[network]
route = "vpn"

ipv4_enabled = true
ipv6_enabled = true

tcp_enabled = true
udp_enabled = true
quic_enabled = true

webrtc_enabled = true

network_lock = true
fail_closed = true
prevent_direct_fallback = true

[vpn]
enabled = true

interface = ""

allow_direct_fallback = false
allow_proxy_fallback = false
allow_tor_fallback = false

require_tunnel = true
require_default_route = true

[network_lock]
enabled = true
fail_closed = true

lock_all_traffic = true
lock_dns = true
lock_ipv4 = true
lock_ipv6 = true

lock_direct_connections = true
lock_proxy_bypass = true
lock_vpn_bypass = true
lock_tor_bypass = true
lock_webrtc = true

[leak_prevention]
enabled = true

prevent_dns_leaks = true
prevent_ipv4_leaks = true
prevent_ipv6_leaks = true
prevent_webrtc_leaks = true

prevent_proxy_bypass = true
prevent_vpn_bypass = true
prevent_tor_bypass = true

[dns]
enabled = true
mode = "doh"

require_encryption = true
require_dnssec = true

allow_system_resolver = false
allow_plaintext_fallback = false

fail_closed = true
prevent_resolver_bypass = true

cache_enabled = true
partition_cache = true

[kill_switch]
enabled = true
fail_closed = true

block_system_dns = true
block_plaintext_dns = true
block_resolver_bypass = true
block_dns_leaks = true
